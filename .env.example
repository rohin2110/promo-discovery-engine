# ---- LLM provider ---------------------------------------------------------
# openai_compatible : any OpenAI-compatible /chat/completions endpoint
#                     (OpenAI, Groq, OpenRouter, Together, Gemini, Anthropic, vLLM, LM Studio ...)
# ollama            : local Ollama server (native /api/chat, no key needed; LLM_API_BASE=http://localhost:11434)
# heuristic         : deterministic offline baseline, no LLM (for demos / no-key environments)
LLM_PROVIDER=openai_compatible
LLM_MODEL=
LLM_API_KEY=
LLM_API_BASE=https://api.openai.com/v1
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=90
LLM_MAX_RETRIES=2
LLM_SEED=42
# json_object | json_schema | none
LLM_RESPONSE_FORMAT=json_object
LLM_SAVE_RAW_RESPONSES=true
# Parallel LLM requests (raise for cloud APIs, keep 1 for local models)
LLM_CONCURRENCY=1
# Context window requested from local Ollama models (prompts are ~3-8k tokens)
LLM_CONTEXT_WINDOW=16384
# Optional provider-specific JSON merged into every request body,
# e.g. {"reasoning_effort": "low"} or {"top_p": 1}
LLM_EXTRA_BODY=

# ---- Optional overrides ---------------------------------------------------
# PROMO_SCORING_CONFIG=config/scoring_config.json
# PROMO_APP_CONFIG=config/app_config.json
# PROMO_LOG_LEVEL=INFO
